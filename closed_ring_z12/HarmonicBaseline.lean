-- Section 1: pair_vector / scalar (mod-144 harmonic weights)
def weights : List Nat := [1, 2, 3, 4, 3, 2, 6, 2, 3, 4, 3, 2]

def pairComponent (seed k weight : Nat) : Nat :=
  let s := seed % 144
  ((s * (k + 1) + weight * 12 + (s + 1) % 12) *
    ((11 - s % 12) * (k + 1) + (s + 6) % 12 * weight)) % 144

def pairVector (seed : Nat) : List Nat :=
  (List.range 12).map (fun k => pairComponent seed k (weights.getD k 0))

def scalar (seed : Nat) : Nat := (pairVector seed).sum % 144

