-- Section 3: scalar ledger aggregates
theorem scalar_parity : ∀ s < 144, scalar s % 2 = s % 2 := by decide

theorem fixed_points : ∀ s < 144,
    (scalar s = s ↔ s = 0 ∨ s = 20 ∨ s = 48 ∨ s = 68 ∨ s = 96 ∨ s = 116) := by
  decide

theorem fixed_points_list :
    (List.range 144).filter (fun s => scalar s == s) = [0, 20, 48, 68, 96, 116] := by
  decide

theorem scalar_outputs : ((List.range 144).map scalar).eraseDups.length = 72 := by
  decide

theorem total_states : (List.range 144).length = 144 := by decide

-- Section 4: functional-graph cycle inventory (rho-walk + canonical rotation)
def walkUntil (succ : Nat → Nat) : Nat → Nat → List Nat → List Nat
  | 0, _, path => path
  | fuel + 1, state, path =>
      if path.contains state then path
      else walkUntil succ fuel (succ state) (path ++ [state])

def indexOfNat (x : Nat) : List Nat → Nat
  | [] => 0
  | h :: t => if h == x then 0 else 1 + indexOfNat x t

-- Canonical cycle representative: left-rotation starting at the minimum,
-- matching the Python fixture's `cycle[offset:] + cycle[:offset]`.
def canonicalCycle (cycle : List Nat) : List Nat :=
  let m := cycle.foldl Nat.min 144
  let off := indexOfNat m cycle
  cycle.drop off ++ cycle.take off

def seedStats (seed : Nat) : Nat × Nat × List Nat :=
  let path := walkUntil scalar 145 seed []
  let rep := scalar ((path.getLast?).getD 0)
  let entry := indexOfNat rep path
  (entry, path.length, canonicalCycle (path.drop entry))

def allStats : List (Nat × Nat × List Nat) := (List.range 144).map seedStats

theorem attractor_cycles : (allStats.map (·.2.2)).eraseDups.length = 23 := by decide
theorem max_entry : (allStats.map (·.1)).foldl Nat.max 0 = 3 := by decide
theorem max_repeat : (allStats.map (·.2.1)).foldl Nat.max 0 = 6 := by decide

-- Section 5: antipodally closed masks over Z/12Z
def maskOf (bits i : Nat) : Nat :=
  if (bits / 2 ^ i) % 2 = 1 then 2 ^ i + 2 ^ (i + 6) else 0

def closedMask (bits : Nat) : Nat := ((List.range 6).map (maskOf bits)).sum

def closedMasks : List Nat := (List.range 64).map closedMask

def bitSet (m i : Nat) : Bool := ((m / 2 ^ i) % 2 == 1)

def isClosedB (m : Nat) : Bool :=
  m < 4096 && ((List.range 6).all (fun i => bitSet m i == bitSet m (i + 6)))

theorem masks_count : closedMasks.length = 64 := by decide
theorem masks_distinct : closedMasks.eraseDups.length = 64 := by decide
theorem masks_all_closed : ∀ m ∈ closedMasks, isClosedB m = true := by decide
theorem mask_pairs_closed : ∀ a ∈ closedMasks, ∀ b ∈ closedMasks,
    isClosedB (Nat.land a b) = true := by decide

-- Section 6: master invariant (mirrors verification_ledger.json)
theorem harmonic_baseline_invariant :
    (∀ s < 144, scalar s % 2 = s % 2) ∧
    (∀ s < 144, scalar s = s ↔
      s = 0 ∨ s = 20 ∨ s = 48 ∨ s = 68 ∨ s = 96 ∨ s = 116) ∧
    ((List.range 144).filter (fun s => scalar s == s) =
      [0, 20, 48, 68, 96, 116]) ∧
    (((List.range 144).map scalar).eraseDups.length = 72) ∧
    ((List.range 144).length = 144) ∧
    ((allStats.map (·.2.2)).eraseDups.length = 23) ∧
    ((allStats.map (·.1)).foldl Nat.max 0 = 3) ∧
    ((allStats.map (·.2.1)).foldl Nat.max 0 = 6) ∧
    (closedMasks.length = 64) ∧
    (closedMasks.eraseDups.length = 64) ∧
    (∀ m ∈ closedMasks, isClosedB m = true) ∧
    (∀ a ∈ closedMasks, ∀ b ∈ closedMasks,
      isClosedB (Nat.land a b) = true) :=
  ⟨scalar_parity, fixed_points, fixed_points_list, scalar_outputs, total_states,
   attractor_cycles, max_entry, max_repeat, masks_count, masks_distinct,
   masks_all_closed, mask_pairs_closed⟩

end HarmonicBaseline
